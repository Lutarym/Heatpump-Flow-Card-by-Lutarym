        },
        "TOP36": ["sensor.*mixer_hc1_flowtemphc"],
        "TOP37": ["sensor.*mixer_hc2_flowtemphc"],
        "TOP42": ["sensor.*thermostat_hc1_targetflowtemp"],
        "TOP43": ["sensor.*thermostat_hc2_targetflowtemp"],
        "TOP47": ["sensor.*solar_collectortemp"],
        "TOP60": ["sensor.*boiler_auxheaterlevel"],
        "TOP62": {"suche": ["sensor.*boiler_fanspd"], "einheit": "%"},
        "TOP65": {"suche": ["sensor.*boiler_hpcircspd", "sensor.*boiler_heatingpumpmod"], "einheit": "%"},
        "TOP69": ["*boiler_dhw_disinfecting", "*boiler_wwdisinfecting"],
        "TOP70": ["number.*boiler_dhw_disinfectiontemp", "number.*boiler_wwdisinfectiontemp"],
        "TOP77": ["number.*thermostat_hc1_summertemp"],
        "TOP115": ["sensor.*boiler_syspress"],
        "TOP123": ["*mixer_hc2_pumpstatus"],
        "TOP124": ["*mixer_hc1_pumpstatus"],
        "OPT5": ["binary_sensor.*solar_solarpump"],
        "SET3": ["select.*boiler_silentmode"],
        "SET10": ["switch.*boiler_dhw_onetime", "switch.*boiler_wwonetime"],
        "SET13": ["switch.*boiler_dhw_disinfecting", "switch.*boiler_wwdisinfecting"],
        "EXT1": ["sensor.*boiler_hpcurrpower", "sensor.*heatpump_hpcurrpower"],
        "EXT2": ["sensor.*boiler_metertotal", "sensor.*boiler_nrgconstotal"],
        "EXT201": ["sensor.*thermostat_hc1_currtemp"],
        "EXT203": ["sensor.*thermostat_hc2_currtemp"],
        "EXT204": ["sensor.*mixer_hc3_flowtemphc"],
        "EXT205": ["*mixer_hc3_pumpstatus"],
        "EXT207": ["sensor.*mixer_hc4_flowtemphc"],
